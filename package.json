{
  "name": "camera-framework-editor",
  "productName": "相机框架编辑器",
  "version": "0.6.0",
  "private": true,
  "description": "Independent desktop editor for Lua CameraFramework assets",
  "main": "electron/main.cjs",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "electron:install": "node node_modules/electron/install.js",
    "test": "node --test tests/*.test.cjs",
    "test:ui": "node tests/smoke.cjs",
    "test:packaged": "node tests/smoke.cjs --packaged",
    "package": "npm run electron:install && electron-builder --win dir",
    "package:installer": "npm run electron:install && electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "@monaco-editor/react": "4.7.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.183.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "monaco-editor": "0.55.1",
    "playwright": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "three": "0.183.2",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  },
  "build": {
    "electronDist": "node_modules/electron/dist",
    "appId": "local.camera.framework.editor",
    "productName": "相机框架编辑器",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules/**/*",
      "!dist/preview/maps/**/*",
      "!dist/preview/characters/**/*",
      "!electron/preview-data/**/*"
    ],
    "extraResources": [
      {
        "from": "runtime",
        "to": "runtime"
      }
    ],
    "win": {
      "target": "dir",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "runAfterFinish": false,
      "artifactName": "CameraFrameworkEditor-${version}-Setup.${ext}"
    }
  }
}
